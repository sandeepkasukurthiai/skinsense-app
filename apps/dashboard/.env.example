# Copy to .env.local and fill in.

# Supabase (public — safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://kniwkgszwqqzgtecpory.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0i2B50r2gAEG-y43r7Gc2Q_03Krdl2L

# Supabase secret key (server only). Dashboard → Project Settings → API Keys → Secret keys.
# Used for patient self-registration, slot booking and webhooks. Never expose to the app.
SUPABASE_SECRET_KEY=

# Public URL of this dashboard (used for payment-link callbacks)
APP_BASE_URL=http://localhost:3000

# Razorpay — Dashboard → Account & Settings → API Keys / Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta) — WhatsApp Manager → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
# Set to "live" to actually send. Anything else logs messages without sending (safe for the demo).
WHATSAPP_MODE=dry-run

# Shared secret for the reminder cron (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
