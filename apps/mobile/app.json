{
  "expo": {
    "name": "The Skin Sensé",
    "slug": "skinsense",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skinsense",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.theskinsense.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Take progress photos of your skin to share with your dermatologist.",
        "NSPhotoLibraryUsageDescription": "Choose progress photos to share with your dermatologist."
      }
    },
    "android": {
      "package": "com.theskinsense.app",
      "adaptiveIcon": {
        "backgroundColor": "#6E165E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4A0E3F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#6E165E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose progress photos to share with your dermatologist.",
          "cameraPermission": "Take progress photos of your skin to share with your dermatologist."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
